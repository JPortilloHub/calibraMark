# CalibraMark Environment Configuration
# Copy this file to .env and fill in your values

# ====================
# Anthropic API
# ====================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ====================
# Polymarket API
# ====================
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_API_SECRET=your_polymarket_api_secret_here
POLYMARKET_PRIVATE_KEY=your_wallet_private_key_here
POLYMARKET_CHAIN_ID=137  # Polygon mainnet

# ====================
# News APIs (Optional)
# ====================
NEWS_API_KEY=your_news_api_key_here  # Optional: newsapi.org

# ====================
# Financial Data APIs (Optional)
# ====================
FRED_API_KEY=your_fred_api_key_here  # Optional: St. Louis Fed
OPENBB_API_KEY=your_openbb_api_key_here  # Optional: OpenBB Platform

# ====================
# Risk Management
# ====================
MAX_POSITION_SIZE_USD=1000
MAX_DAILY_LOSS_USD=200
MAX_DRAWDOWN_PERCENT=20
KELLY_FRACTION=0.25  # Fractional Kelly (25% of full Kelly)
MIN_EDGE_THRESHOLD=0.05  # Minimum 5% edge to trade

# ====================
# Trading Mode
# ====================
PAPER_TRADING_MODE=true
PAPER_TRADING_STARTING_BANKROLL=10000

# ====================
# Logging
# ====================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_DIR=data/logs

# ====================
# Data Storage
# ====================
DATA_DIR=data

# ====================
# Scheduling
# ====================
SCAN_TIME_UTC=10:00  # Daily scan time in UTC
SCAN_ENABLED=true

# ====================
# Market Scanning Filters
# ====================
MIN_MARKET_LIQUIDITY=10000  # Minimum $10k liquidity
MIN_DAYS_UNTIL_RESOLUTION=1
MAX_DAYS_UNTIL_RESOLUTION=90

# ====================
# Backtesting
# ====================
BACKTEST_START_DATE=2024-07-01
BACKTEST_END_DATE=2025-01-31
